# Copia este archivo como .env y pon los datos de TU MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cecyt9_local
PORT=3001

# Con qué se firman los JWT. Valor largo y secreto: NUNCA se sube al repo (.env está en .gitignore).
# Si lo cambias, todos los tokens que ya existen dejan de servir.
JWT_SECRET=cambia-este-secreto-largo
# Cuántos SEGUNDOS dura un token (15 minutos = 900).
JWT_EXPIRA_SEG=900
